# --- Peitho: never commit business data or credentials ---
# The backend mirror, raw recordings, and any live financial data stay local.
data/
*.duckdb
*.duckdb.wal
*.parquet
*.jsonl
recordings/
*recording*.json

# Secrets / auth
.env
.env.*
!.env.example
*.jwt
*token*.json
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Coverage artifacts (regenerated by CI for the Sonar scan; never source)
.coverage
coverage.xml

# Tooling caches
.ruff_cache/
.lintgate/
.pytest_cache/
.mypy_cache/
.ty_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# tool working dirs
.detective/
.serena/
.wesker/

# mutation testing (mutmut) working dir
mutants/
.mutmut-cache
mutmut-stats.json

# Private company cassettes — live on the SD card, never public (airgap). Only the example ships.
cassettes/*/
!cassettes/example/
