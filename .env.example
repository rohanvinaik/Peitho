# Peitho config template — copy to .env (gitignored) and fill in. Nothing here is committed.
# The core has no secrets of its own; a backend adapter keeps its own credentials in the OS keychain,
# not here.

# The company build to load (a cassette directory). Unset → the bundled synthetic example.
PEITHO_CASSETTE=

# The data volume a file-backed adapter reads from ($PEITHO_ROOT/data). Unset → auto-detected repo root.
PEITHO_ROOT=
